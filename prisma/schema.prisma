generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)
  assignee    Assignee   @default(BOTH)
  label       Label      @default(WORK)
  dueDate     DateTime?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  source      String?
  sourceId    String?
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Assignee {
  MAX
  VINCE
  BOTH
}

enum Label {
  WORK
  PERSONAL
  CONSULTING
  VAPT
  DEFENSEWATCH
  REMINDER
}
